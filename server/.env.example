# Backend Environment Variables
# Copy this file to .env and fill in your values

# Server Configuration
PORT=5000
NODE_ENV=development
YOUR_SITE_URL=https://tourism-and-travel-tech-front.onrender.com

# Database
MONGODB_URL=mongodb://localhost:27017/smart-travel-assistant

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRE=7d

# API Keys

# PredictHQ API (for events data)
PREDICTHQ_API_KEY=your-predicthq-api-key

# Unsplash API (for destination images)
# Get your free API key at: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=your-unsplash-access-key
UNSPLASH_SECRET_KEY=your-unsplash-secret-key

# Twilio SMS API (for real notifications)
# Sign up at: https://www.twilio.com/try-twilio
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number

# Google Places API (for location data)
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret